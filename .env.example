# انسخ هذا الملف إلى .env أو صدّر المتغير في بيئة التشغيل.
# لا تضع المفتاح الحقيقي داخل Git أو JavaScript الواجهة.
BROWSERBASE_API_KEY=<YOUR_API_KEY>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
# النموذج الافتراضي المختار للتحليل المهيكل؛ يمكن تغييره حسب مزودك.
OPENAI_MODEL=gpt-6-luna
# اختياري: اتركه فارغًا لاستخدام نقطة OpenAI الافتراضية.
OPENAI_API_BASE=
